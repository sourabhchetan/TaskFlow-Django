# Copy this file to .env and fill in real values for your environment.
# .env is never committed to source control (see .gitignore). Variable names
# match what config/settings.py reads via os.environ.get(...).

DJANGO_SECRET_KEY=your-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
DJANGO_SECURE_COOKIES=True

# Comma-separated, scheme required (https://...). Only needed once DEBUG=False
# and the site is served over HTTPS from a real domain — see README >
# Deploying to Render. Leave blank for local HTTP development.
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Leave everything below blank to use SQLite (the local-dev default).
#
# Option A — DATABASE_URL (what Render provides automatically, and the
# simplest way to point at any Postgres instance, local or hosted):
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Option B — the original explicit variables, e.g. for a local Postgres via
# docker-compose. Only used when DATABASE_URL above is blank. Set
# DB_ENGINE=postgresql to activate this block.
DB_ENGINE=
DB_NAME=todo_list
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional: only needed if/when email-based reminders are wired up.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
